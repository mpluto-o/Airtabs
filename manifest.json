{
  "manifest_version": 3,
  "name": "Airtabs",
  "version": "1.0",
  "description": "Send tabs across your network.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Airtabs",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "airtabs@pluto.extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://*.firebaseio.com/*"
  ]

}